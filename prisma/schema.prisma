generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ——— Auth (NextAuth v5) ———————————————————————————

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ——— Products & Categories ————————————————————————

model Category {
  id           String    @id @default(cuid())
  name         String    @unique
  description  String?
  productCount Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]

  @@map("categories")
}

model Product {
  id              String           @id @default(cuid())
  sku             String           @unique
  name            String
  categoryId      String
  description     String?
  costPrice       Float
  sellingPrice    Float
  stock           Int              @default(0)
  minStock        Int              @default(5)
  unit            String           @default("pcs")
  image           String?
  isActive        Boolean          @default(true)
  isSerialTracked Boolean          @default(false)
  warrantyMonths  Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  category        Category         @relation(fields: [categoryId], references: [id])
  serializedItems SerializedItem[]
  transactionItems TransactionItem[]
  stockInItems    StockInItem[]

  @@map("products")
}

// ——— Customers ————————————————————————————————————

model Customer {
  id            String           @id @default(cuid())
  name          String
  phone         String?
  email         String?
  address       String?
  notes         String?
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  transactions  Transaction[]
  serializedItems SerializedItem[]
  warrantyClaims  WarrantyClaim[]

  @@map("customers")
}

// ——— Suppliers ————————————————————————————————————

model Supplier {
  id             String          @id @default(cuid())
  name           String
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  notes          String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  stockIns       StockIn[]
  warrantyClaims WarrantyClaim[]

  @@map("suppliers")
}

// ——— Employees ————————————————————————————————————

model Employee {
  id           String        @id @default(cuid())
  name         String
  role         String?
  phone        String?
  email        String?
  address      String?
  hireDate     DateTime?
  salary       Float?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]

  @@map("employees")
}

// ——— Serialized Items —————————————————————————————

model SerializedItem {
  id              String          @id @default(cuid())
  productId       String
  serialNumber    String          @unique
  status          String          @default("in_stock")
  condition       String          @default("new")
  purchaseId      String?
  purchaseDate    DateTime?
  purchaseCost    Float?
  transactionId   String?
  soldDate        DateTime?
  soldPrice       Float?
  customerId      String?
  warrantyMonths  Int?
  warrantyExpiry  DateTime?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  product         Product         @relation(fields: [productId], references: [id])
  purchase        StockIn?        @relation(fields: [purchaseId], references: [id])
  transaction     Transaction?    @relation(fields: [transactionId], references: [id])
  customer        Customer?       @relation(fields: [customerId], references: [id])
  warrantyClaims  WarrantyClaim[]
  replacementFor  WarrantyClaim[] @relation("ReplacementSerial")

  @@map("serialized_items")
}

// ——— Transactions (Sales) —————————————————————————

model Transaction {
  id              String            @id @default(cuid())
  receiptNo       String            @unique
  customerId      String?
  employeeId      String?
  date            DateTime          @default(now())
  subtotal        Float
  discount        Float             @default(0)
  tax             Float             @default(0)
  total           Float
  paymentMethod   String            @default("cash")
  amountPaid      Float             @default(0)
  change          Float             @default(0)
  notes           String?
  status          String            @default("completed")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  customer        Customer?         @relation(fields: [customerId], references: [id])
  employee        Employee?         @relation(fields: [employeeId], references: [id])
  items           TransactionItem[]
  serializedItems SerializedItem[]

  @@map("transactions")
}

model TransactionItem {
  id            String   @id @default(cuid())
  transactionId String
  productId     String
  quantity      Int
  unitPrice     Float
  subtotal      Float
  createdAt     DateTime @default(now())
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id])

  @@map("transaction_items")
}

// ——— Stock In (Purchases) —————————————————————————

model StockIn {
  id          String        @id @default(cuid())
  invoiceNo   String        @unique
  supplierId  String
  date        DateTime      @default(now())
  total       Float         @default(0)
  status      String        @default("pending")
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  supplier    Supplier      @relation(fields: [supplierId], references: [id])
  items       StockInItem[]
  serializedItems SerializedItem[]

  @@map("stock_ins")
}

model StockInItem {
  id        String   @id @default(cuid())
  stockInId String
  productId String
  quantity  Int
  unitCost  Float
  subtotal  Float
  createdAt DateTime @default(now())
  stockIn   StockIn  @relation(fields: [stockInId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@map("stock_in_items")
}

// ——— Warranty Claims ——————————————————————————————

model WarrantyClaim {
  id                  String              @id @default(cuid())
  claimNumber         String              @unique
  serializedItemId    String
  claimType           String
  status              String              @default("pending")
  claimDate           DateTime            @default(now())
  issueDescription    String
  customerId          String?
  supplierId          String?
  repairCost          Float?
  replacementSerialId String?
  resolution          String?
  attachments         String[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  serializedItem      SerializedItem      @relation(fields: [serializedItemId], references: [id])
  customer            Customer?           @relation(fields: [customerId], references: [id])
  supplier            Supplier?           @relation(fields: [supplierId], references: [id])
  replacementSerial   SerializedItem?     @relation("ReplacementSerial", fields: [replacementSerialId], references: [id])
  notes               WarrantyClaimNote[]

  @@map("warranty_claims")
}

model WarrantyClaimNote {
  id              String        @id @default(cuid())
  warrantyClaimId String
  note            String
  createdBy       String
  createdAt       DateTime      @default(now())
  warrantyClaim   WarrantyClaim @relation(fields: [warrantyClaimId], references: [id], onDelete: Cascade)

  @@map("warranty_claim_notes")
}

// ——— Expenses —————————————————————————————————————

model Expense {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  category    String
  description String
  amount      Float
  receipt     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("expenses")
}

// ——— Settings —————————————————————————————————————

model Settings {
  id                    String   @id @default("default")
  storeName             String   @default("Inventra")
  address               String?
  phone                 String?
  email                 String?
  logo                  String?
  receiptHeader         String?
  receiptFooter         String?
  currency              String   @default("$")
  taxRate               Float    @default(0)
  taxEnabled            Boolean  @default(false)
  lowStockThreshold     Int      @default(10)
  defaultWarrantyMonths Int      @default(12)
  warrantyAlertDays     Int      @default(30)
  claimNumberPrefix     String   @default("WC-")
  featureToggles        Json     @default("{}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("settings")
}
